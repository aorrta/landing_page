# Cloudflare Pages runs `npx @cloudflare/next-on-pages@1` to build. That package
# pulls the latest wrangler, whose peer @cloudflare/workers-types (v5) conflicts
# with next-on-pages' own peer (v4), so npm aborts with ERESOLVE and the deploy
# fails. Force npm's legacy peer resolution so the install/build proceeds.
legacy-peer-deps=true
